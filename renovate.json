{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigestsToSemver"
  ],
  "packageRules": [
    {
      "description": "Keep this repository's own actions tracking their branch",
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["connectbot/actions"],
      "pinDigests": false
    }
  ]
}
